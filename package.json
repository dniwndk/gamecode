{
  "name": "brass-life",
  "private": true,
  "version": "1.0.0",
  "description": "황동의 생애 — 증기 도시에서 한 사람의 생애를 사는 텍스트 시뮬레이션",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "python3 -m http.server 8000",
    "preview": "npm run build && python3 -m http.server 8000 --directory dist",
    "test": "node tests/sim.test.mjs --quick && node tests/audit.mjs --quick",
    "test:browser": "node tests/e2e.spec.mjs && node tests/audit-browser.mjs",
    "test:dist": "node tests/dist.spec.mjs",
    "icons": "node tools/icons.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  }
}
