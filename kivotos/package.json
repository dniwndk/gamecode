{
  "name": "kivotos-tactical-frontline",
  "private": true,
  "version": "0.0.0",
  "description": "키보토스 택티컬 프론트라인 — 블루 아카이브 팬메이드 솔로 웹 오토배틀러",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "content:extract": "node scripts/extract-content.mjs",
    "content:check": "node scripts/extract-content.mjs --check",
    "content:validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:content": "vitest run tests/content",
    "build": "npm run content:check && npm run content:validate && npm run typecheck && vite build",
    "preview": "vite preview --port 4174"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@webgpu/types": "0.1.74",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/black-han-sans": "5.3.0"
  }
}
